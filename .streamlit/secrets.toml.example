# Copy this file to secrets.toml (same folder) for local runs,
# or paste these lines into "Secrets" on Streamlit Community Cloud.
OPENROUTER_API_KEY = "sk-or-v1-paste-your-key-here"

# Models, tried IN ORDER: if one fails (rate-limited, overloaded, timed out),
# the next one answers. Fast + reliable first, different providers where
# possible; openrouter/free = any free tool-capable model (safety net);
# nemotron-3.5-lightning last = slow but has been reliable.
# Test with:  python test_models.py          (each model alone)
#             python test_models.py --chain  (whole list, like the app)
MODEL = "inclusionai/ling-3.0-flash-sante:free, google/gemma-4-26b-a4b-it:free, nvidia/nemotron-3-super-120b-a12b:free, google/gemma-4-31b-it:free, qwen/qwen3.8-27b:free, openrouter/free, nvidia/nemotron-3.5-lightning:free"

# Seconds to wait for ONE model reply before moving to the next model
# (at least 2 minutes for slow free models; default 180)
LLM_TIMEOUT = 180

# If EVERY model fails, wait (5s, then 10s, ...) and try the whole list again
# this many times. Busy free providers usually recover within seconds.
RETRY_ROUNDS = 2

# How long the model "thinks" first: none | minimal | low | medium | high
# Lower = faster answers. "none" is rejected by some models - then use "low".
REASONING_EFFORT = "low"

# ---------------- Optional: LangSmith observability ----------------
# Free Developer plan at https://smith.langchain.com (5,000 traces/month,
# 14-day retention). Create an API key: Settings -> API Keys.
# Remove the # at the start of the lines below to switch it on.
# The project is created automatically on the first question.
# LANGSMITH_API_KEY = "lsv2_pt_paste-your-key-here"
# LANGSMITH_PROJECT = "jarvis-agent"
# Only if you chose a NON-US region when signing up:
# LANGSMITH_ENDPOINT = "https://eu.api.smith.langchain.com"     # Europe
# LANGSMITH_ENDPOINT = "https://apac.api.smith.langchain.com"   # Asia-Pacific
